#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <130>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none         &kp N1              &kp N2    &kp N3            &kp N4    &kp N5  &tog 1                                                     &mo 3          &kp N6   &kp N7    &kp N8             &kp N9   &kp N0               &none
&kp CAPSLOCK  &kp X               &kp L     &kp D             &kp M     &kp Z   &none                                                      &none          &kp SQT  &kp W     &kp O              &kp U    &kp J                &none
&kp TAB       &hm LEFT_CONTROL S  &hml 2 R  &hm LEFT_SHIFT T  &hml 1 N  &kp B   &none      &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL   &none          &kp Y    &hml 1 C  &hm RIGHT_SHIFT A  &kp E    &hm RIGHT_CONTROL I  &kp LEFT_GUI
&kp ESCAPE    &kp V               &kp K     &kp H             &kp P     &kp Q                         &kp HOME      &kp PG_UP                             &kp G    &kp F     &kp COMMA          &kp DOT  &kp FSLH             &none
&none         &none               &none     &none             &none             &kp SPACE  &kp ENTER  &kp END       &kp PG_DN  &kp DELETE  &kp BACKSPACE           &none     &none              &none    &none                &none
            >;
        };

        programmingRight {
            display-name = "Kp";
            bindings = <
&none  &none        &none           &none           &none            &none      &trans                                                   &none      &none      &none                 &none                  &none           &none            &none
&none  &kp DOLLAR   &kp PIPE        &kp UP_ARROW    &kp AMPERSAND    &kp STAR   &none                                                    &none      &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE  &none
&none  &kp UNDER    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TILDE  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp PLUS         &none
&none  &kp PERCENT  &kp CARET       &kp AT          &kp HASH         &none                           &kp HOME      &kp PG_UP                        &none      &kp SEMI              &kp COLON              &kp BACKSLASH   &kp EXCL         &none
&none  &none        &none           &none           &none                       &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0             &none                 &none                  &none           &none            &none
            >;
        };

        numbers {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans     &trans                                      &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &kp LC(A)  &kp LC(Z)  &kp LC(Y)  &trans                                      &trans  &trans  &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans  &trans  &trans  &kp LC(C)  &kp LC(V)  &kp LC(F)  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N7        &trans
&trans  &trans  &trans  &kp LC(X)  &kp LC(S)  &trans                     &trans      &trans                  &trans  &kp N8        &kp N9        &trans        &trans        &trans
&trans  &trans  &trans  &trans     &trans                &trans  &trans  &trans      &trans  &trans  &trans          &trans        &trans        &trans        &trans        &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
