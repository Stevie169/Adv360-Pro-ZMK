#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hmShiftL: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 38 39 40 41 42 43 44 45 54 55 56 57 58 59 69 70 71 72 73 74 75 37 53 68>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            tapping-term-ms = <125>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
        };

        hmdelayed: hmdelayed {
            compatible = "zmk,behavior-hold-tap";
            label = "HMDELAYED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hmShiftR: hmShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <31 32>;
        };

        screenshot {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <29 30 31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none         &kp F1                     &kp F2    &kp F3                  &kp F4                 &kp F5  &none                                               &mo 5          &kp F6   &kp F7                  &kp F8                   &kp F9    &kp F10                         &kp F11
&kp CAPSLOCK  &kp X                      &kp L     &kp D                   &kp M                  &kp Z   &none                                               &none          &kp SQT  &kp W                   &kp O                    &kp U     &kp J                           &kp F12
&kp TAB       &kp S                      &hml 2 R  &hmShiftL LEFT_SHIFT T  &hml 1 N               &kp B   &none      &none      &none      &none  &none       &none          &kp Y    &hml 1 C                &hmShiftR RIGHT_SHIFT A  &hml 4 E  &kp I                           &kp RIGHT_SHIFT
&kp LEFT_WIN  &hmdelayed LEFT_CONTROL V  &kp K     &kp H                   &hmdelayed LEFT_ALT P  &kp Q                         &none      &none                             &kp G    &hmdelayed RIGHT_ALT F  &kp COMMA                &kp DOT   &hmdelayed RIGHT_CONTROL SLASH  &none
&none         &none                      &none     &none                   &none                          &kp SPACE  &kp ENTER  &none      &none  &kp DELETE  &kp BACKSPACE           &none                   &none                    &none     &none                           &none
            >;
        };

        programmingRight {
            display-name = "Kp";
            bindings = <
&trans  &trans       &trans          &trans          &trans           &trans     &trans                                      &trans  &trans     &trans                &trans                 &trans          &trans           &trans
&trans  &kp DOLLAR   &kp PIPE        &kp UP_ARROW    &kp AMPERSAND    &kp STAR   &trans                                      &trans  &kp GRAVE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
&trans  &kp UNDER    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp TILDE  &trans  &trans  &trans      &trans  &trans  &trans  &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp PLUS         &trans
&trans  &kp PERCENT  &kp CARET       &kp AT          &kp HASH         &trans                     &trans      &trans                  &trans     &kp SEMI              &kp COLON              &kp BACKSLASH   &kp EXCL         &trans
&trans  &trans       &trans          &trans          &trans                      &trans  &trans  &trans      &trans  &trans  &trans             &trans                &trans                 &trans          &trans           &trans
            >;
        };

        numbers {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans     &trans                                      &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &kp LC(A)  &kp LC(Z)  &kp LC(Y)  &trans                                      &trans  &trans  &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans  &trans  &trans  &kp LC(C)  &kp LC(V)  &kp LC(F)  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N7        &trans
&trans  &trans  &trans  &kp LC(X)  &kp LC(S)  &trans                     &trans      &trans                  &trans  &kp N8        &kp N9        &trans        &trans        &trans
&trans  &trans  &trans  &trans     &trans                &trans  &trans  &trans      &trans  &trans  &trans          &trans        &trans        &trans        &trans        &trans
            >;
        };

        functions {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans              &trans         &trans               &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans              &trans         &trans               &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp HOME            &kp PG_UP      &kp END              &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LC(LEFT_ARROW)  &kp PAGE_DOWN  &kp LC(RIGHT_ARROW)  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans              &trans         &trans                       &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
